          "Find-NetRoute -RemoteIPAddress",
          "Resolve-DnsName",
          "Test-NetConnection -Port",
          "Get-NetTCPConnection -State Listen",
          "Get-NetFirewallRule",
          "pktmon or Wireshark"
        ]
      },
      "say": "The commands look different, but each step has a Linux and a Windows version. Know both, and you'll never be caught off guard."
